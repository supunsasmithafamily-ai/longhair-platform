rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{fileName} {
      // Anyone can view content (public wall previews; private-content gating
      // for who gets a usable download URL should ultimately move to signed
      // URLs generated by a Cloud Function once you have real users, but for
      // launch the app relies on not exposing private fileUrls to non-buyers
      // in Firestore reads — reasonable v1, not bulletproof).
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 500 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
